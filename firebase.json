{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        ".firebase",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "site": "programovanie-sps",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      ".github/**",
      "firestore.rules",
      "FIREBASE_SETUP.md",
      "skills-lock.json"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Programovanie SPS",
        "supportEmail": "dusan.cabala.sps@gmail.com",
        "authorizedRedirectUris": [
          "https://programovanie-gules.vercel.app",
          "https://programovanie-sps.firebaseapp.com/__/auth/handler"
        ]
      }
    }
  }
}
