rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function signedIn() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isTeacher() {
      // No-cost alternative to Identity Platform blocking functions and custom claims:
      // grant teacher access only to this verified Google account. Firestore evaluates
      // this on every request; the client UI is not the security boundary.
      return signedIn()
        && request.auth.token.email == 'dusan.cabala.sps@gmail.com';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return request.resource.data.ownerUid == resource.data.ownerUid;
    }

    function isValidRemoteSession(data) {
      return data.keys().hasOnly([
          'ownerUid', 'pageTitle', 'pagePath', 'pageActive', 'pageHeartbeatAt',
          'playbackState', 'canReplay', 'canRestartCurrent', 'displayMode', 'createdAt'
        ])
        && data.ownerUid is string
        && data.pageTitle is string
        && data.pageTitle.size() > 0
        && data.pageTitle.size() <= 160
        && data.pagePath is string
        && data.pagePath.size() <= 500
        && data.pageActive is bool
        && data.pageHeartbeatAt is timestamp
        && data.playbackState in ['stopped', 'playing', 'paused']
        && data.canReplay is bool
        && data.canRestartCurrent is bool
        && data.displayMode in ['student', 'teacher']
        && data.createdAt is timestamp;
    }

    function isValidRemoteCommand(data, sessionId) {
      return data.targetSessionId == sessionId
        && data.createdAt == request.time
        && (
          (data.type in ['play', 'pauseResume', 'stop', 'restartLesson', 'restartCurrent']
            && data.keys().hasOnly(['type', 'targetSessionId', 'createdAt']))
          || (data.type == 'panelClick'
            && data.keys().hasOnly(['type', 'targetSessionId', 'createdAt', 'controlIndex'])
            && data.controlIndex is int
            && data.controlIndex >= 0
            && data.controlIndex <= 40)
          || (data.type == 'panelChange'
            && data.keys().hasOnly(['type', 'targetSessionId', 'createdAt', 'controlIndex', 'value'])
            && data.controlIndex is int
            && data.controlIndex >= 0
            && data.controlIndex <= 40
            && data.value is string
            && data.value.size() <= 200)
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isTeacher());
      allow write: if false;
    }

    match /activities/{activityId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isTeacher());
      allow write: if false;
    }

    match /mail/{messageId} {
      allow read, write: if false;
    }

    // The teacher's existing Firebase account is the remote-control authorization.
    function ownsRemoteSession(sessionId) {
      return isTeacher()
        && exists(/databases/$(database)/documents/remoteSessions/$(sessionId))
        && get(/databases/$(database)/documents/remoteSessions/$(sessionId)).data.ownerUid == request.auth.uid;
    }

    match /remoteSessions/{sessionId} {
      allow get: if isTeacher()
        && (sessionId == request.auth.uid || resource.data.ownerUid == request.auth.uid);
      allow list: if isTeacher() && resource.data.ownerUid == request.auth.uid;

      allow create: if isTeacher()
        && isValidRemoteSession(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.pageActive == true
        && request.resource.data.playbackState == 'stopped'
        && request.resource.data.canReplay == false
        && request.resource.data.canRestartCurrent == false
        && request.resource.data.displayMode in ['student', 'teacher']
        && request.resource.data.createdAt == request.time
        && request.resource.data.pageHeartbeatAt == request.time;

      // Only the owner page may publish liveness/playback state.
      allow update: if isTeacher()
        && isOwner(resource.data.ownerUid)
        && isValidRemoteSession(request.resource.data)
        && uidUnchanged()
        && request.resource.data.pageTitle is string
        && request.resource.data.pagePath is string
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.pageActive is bool
        && request.resource.data.playbackState in ['stopped', 'playing', 'paused']
        && request.resource.data.canReplay is bool
        && request.resource.data.canRestartCurrent is bool
        && request.resource.data.displayMode in ['student', 'teacher']
        && request.resource.data.pageHeartbeatAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pageTitle', 'pagePath', 'pageActive', 'pageHeartbeatAt',
          'playbackState', 'canReplay', 'canRestartCurrent', 'displayMode'
        ]);

      allow delete: if isTeacher() && resource.data.ownerUid == request.auth.uid;

      match /commands/{commandId} {
        allow read: if ownsRemoteSession(sessionId);
        allow create: if ownsRemoteSession(sessionId)
          && get(/databases/$(database)/documents/remoteSessions/$(sessionId)).data.pageActive == true
          && get(/databases/$(database)/documents/remoteSessions/$(sessionId)).data.pageHeartbeatAt > request.time - duration.value(45, 's')
          && isValidRemoteCommand(request.resource.data, sessionId);
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
