rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function signedIn() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isTeacher() {
      // No-cost alternative to Identity Platform blocking functions and custom claims:
      // grant teacher access only to this verified Google account. Firestore evaluates
      // this on every request; the client UI is not the security boundary.
      return signedIn()
        && request.auth.token.email == 'dusan.cabala.sps@gmail.com';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return request.resource.data.ownerUid == resource.data.ownerUid;
    }

    function isValidRemoteSession(data) {
      return data.keys().hasOnly([
          'ownerUid', 'pageTitle', 'pagePath', 'pairingCode', 'pairExpiresAt',
          'pairedDeviceId', 'pairedAt', 'pageActive', 'pageHeartbeatAt',
          'playbackState', 'canReplay', 'createdAt'
        ])
        && data.ownerUid is string
        && data.pageTitle is string
        && data.pageTitle.size() > 0
        && data.pageTitle.size() <= 160
        && data.pagePath is string
        && data.pagePath.size() <= 500
        && (data.pairingCode == null || (data.pairingCode is string && data.pairingCode.matches('^[0-9]{6}$')))
        && (data.pairExpiresAt == null || data.pairExpiresAt is timestamp)
        && (data.pairedDeviceId == null || (data.pairedDeviceId is string && data.pairedDeviceId.size() >= 20 && data.pairedDeviceId.size() <= 80))
        && (data.pairedAt == null || data.pairedAt is timestamp)
        && data.pageActive is bool
        && data.pageHeartbeatAt is timestamp
        && data.playbackState in ['stopped', 'playing', 'paused']
        && data.canReplay is bool
        && data.createdAt is timestamp;
    }

    function isValidRemoteCommand(data, sessionId, pairedDeviceId) {
      return data.keys().hasOnly(['type', 'targetSessionId', 'deviceId', 'createdAt'])
        && data.type in ['play', 'pauseResume', 'stop', 'replay']
        && data.targetSessionId == sessionId
        && data.deviceId == pairedDeviceId
        && data.createdAt == request.time;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isTeacher());
      allow write: if false;
    }

    match /activities/{activityId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isTeacher());
      allow write: if false;
    }

    match /mail/{messageId} {
      allow read, write: if false;
    }

    // Teacher-only remote speech control. Session IDs are random per page load;
    // a paired device can write commands only to its exact live session.
    function ownsRemoteSession(sessionId) {
      return isTeacher()
        && exists(/databases/$(database)/documents/remoteSessions/$(sessionId))
        && get(/databases/$(database)/documents/remoteSessions/$(sessionId)).data.ownerUid == request.auth.uid;
    }

    match /remoteSessions/{sessionId} {
      allow get, list: if isTeacher() && resource.data.ownerUid == request.auth.uid;

      allow create: if isTeacher()
        && isValidRemoteSession(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.pairingCode is string
        && request.resource.data.pairingCode.matches('^[0-9]{6}$')
        && request.resource.data.pairedDeviceId == null
        && request.resource.data.pairedAt == null
        && request.resource.data.pageActive == true
        && request.resource.data.playbackState == 'stopped'
        && request.resource.data.canReplay == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.pageHeartbeatAt == request.time
        && request.resource.data.pairExpiresAt > request.time
        && request.resource.data.pairExpiresAt < request.time + duration.value(3, 'm');

      // Pairing is one-time and expires quickly. After pairing, only page
      // liveness and playback state may be changed by the page.
      allow update: if isTeacher()
        && isOwner(resource.data.ownerUid)
        && isValidRemoteSession(request.resource.data)
        && uidUnchanged()
        && request.resource.data.pageTitle == resource.data.pageTitle
        && request.resource.data.pagePath == resource.data.pagePath
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (
            resource.data.pairedDeviceId == null
            && resource.data.pairExpiresAt > request.time
            && request.resource.data.pairingCode == null
            && request.resource.data.pairExpiresAt == null
            && request.resource.data.pairedDeviceId is string
            && request.resource.data.pairedDeviceId.size() >= 20
            && request.resource.data.pairedDeviceId.size() <= 80
            && request.resource.data.pairedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'pairingCode', 'pairExpiresAt', 'pairedDeviceId', 'pairedAt'
            ])
          )
          || (
            request.resource.data.pairedDeviceId == resource.data.pairedDeviceId
            && request.resource.data.pairedAt == resource.data.pairedAt
            && request.resource.data.pairingCode == resource.data.pairingCode
            && request.resource.data.pairExpiresAt == resource.data.pairExpiresAt
            && request.resource.data.pageActive is bool
            && request.resource.data.playbackState in ['stopped', 'playing', 'paused']
            && request.resource.data.canReplay is bool
            && request.resource.data.pageHeartbeatAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'pageActive', 'pageHeartbeatAt', 'playbackState', 'canReplay'
            ])
          )
        );

      allow delete: if isTeacher() && resource.data.ownerUid == request.auth.uid;

      match /commands/{commandId} {
        allow read: if ownsRemoteSession(sessionId);
        allow create: if ownsRemoteSession(sessionId)
          && get(/databases/$(database)/documents/remoteSessions/$(sessionId)).data.pageActive == true
          && get(/databases/$(database)/documents/remoteSessions/$(sessionId)).data.pageHeartbeatAt > request.time - duration.value(45, 's')
          && request.resource.data.deviceId is string
          && isValidRemoteCommand(
            request.resource.data,
            sessionId,
            get(/databases/$(database)/documents/remoteSessions/$(sessionId)).data.pairedDeviceId
          );
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
